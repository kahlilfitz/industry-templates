{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.credential-case-study-assembly.v1",
  "title": "Credential & Case Study Assembly contract v1",
  "description": "Versioned contract chaining closeout-retrieve -> credential-draft -> permission-check -> anonymize-variant -> credential-record. Carries data, confidence, provenance and citations on every hop.",
  "type": "object",
  "required": ["contract_version", "engagement", "client", "outcomes", "provenance"],
  "properties": {
    "contract_version": { "const": "ps.credential-case-study-assembly.v1" },
    "request": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "requested_use": { "enum": ["pitch_only", "public_marketing", "press"] },
        "requested_on": { "type": "string" },
        "requester": { "type": "string" },
        "proposed_anonymised_descriptor": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "engagement": {
      "type": "object",
      "required": ["engagement_id", "name", "closeout_date", "source", "confidence", "citations"],
      "properties": {
        "engagement_id": { "type": "string" },
        "name": { "type": "string" },
        "closeout_date": { "type": "string" },
        "fees_usd": { "type": "number" },
        "duration_weeks": { "type": "integer" },
        "board_visible": { "type": "boolean" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "client": {
      "type": "object",
      "required": ["name", "sector", "source", "confidence", "citations"],
      "properties": {
        "name": { "type": "string" },
        "sector": { "type": "string" },
        "geography": { "type": "string" },
        "size_descriptor": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "source", "confidence", "citations"],
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "citations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "unit", "evidence_type", "source", "confidence", "citations"],
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "evidence_type": { "enum": ["verified_deliverable", "reference_register", "client_internal_estimate", "anecdotal", "draft"] },
          "clearance_scope": { "enum": ["pitch_only", "public_marketing", "press", "uncleared"] },
          "clearance_state": { "enum": ["cleared", "uncleared", "restricted"] },
          "governing_clause": { "type": "string" },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "citations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "terms": {
      "type": "object",
      "properties": {
        "clauses": { "type": "array", "items": { "type": "object" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reference_register": {
      "type": "object",
      "properties": {
        "permissions": { "type": "array", "items": { "type": "object" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "taxonomy_match": {
      "type": "object",
      "properties": {
        "sector": { "type": "object" },
        "service_line": { "type": "object" },
        "capability": { "type": "object" },
        "engagement_size_band": { "type": "object" },
        "outcome_type": { "type": "object" },
        "escalations": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permission_verdict": {
      "type": "object",
      "properties": {
        "naming_status": { "enum": ["permit_to_name", "refuse_to_name"] },
        "naming_rationale": { "type": "string" },
        "name_governing_clause": { "type": "string" },
        "logo_status": { "enum": ["permit_logo", "refuse_logo"] },
        "testimonial_status": { "enum": ["permit_testimonial", "refuse_testimonial", "not_requested"] },
        "anonymised_variant_required": { "type": "boolean" },
        "proposed_descriptor_status": { "enum": ["safe", "reidentifying", "not_provided"] },
        "safe_descriptor": { "type": "string" },
        "cleared_figures": { "type": "array", "items": { "type": "object" } },
        "uncleared_figures": { "type": "array", "items": { "type": "object" } },
        "escalations": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "draft_assets": {
      "type": "object",
      "properties": {
        "credential_entry": { "type": "object" },
        "case_study": { "type": "object" },
        "anonymised_variant": { "type": "object" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engines", "generated_at", "demo_scenario"],
      "properties": {
        "engines": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string" },
        "demo_scenario": { "type": "string" }
      }
    }
  }
}
