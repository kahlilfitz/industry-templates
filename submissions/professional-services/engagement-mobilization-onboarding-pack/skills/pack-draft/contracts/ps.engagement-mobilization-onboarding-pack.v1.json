{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ps.engagement-mobilization-onboarding-pack.v1",
  "title": "Engagement Mobilization & Onboarding Pack v1",
  "description": "Shared contract for the 5-skill chain engagement-retrieve -> roster-pull -> knowledge-match -> wall-check -> pack-draft. Engines own every status, verdict, score and access decision; the model drafts cited prose only. Upstream adapters: Scenario 01 closeout (ps.engagement-closeout-knowledge-harvest.v1; knowledge_record + released_assets only, never held_assets/candidate_assets) and Scenario 02 staffing (ps.engagement-staffing-bench-match.v1; slate names are proposed, never assigned). Every engine validates the intermediate document it reads against this schema (nested types, list element types, enums, ranges); a violation is a clean InputError (confidentiality-and-ethical-wall-rules.md #1.3).",
  "type": "object",
  "required": [
    "contract_version",
    "run_metadata",
    "engagement",
    "provenance"
  ],
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "const": "ps.engagement-mobilization-onboarding-pack.v1"
    },
    "run_metadata": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "demo_scenario": {
          "type": "string"
        }
      }
    },
    "engagement": {
      "type": "object",
      "properties": {
        "engagement_id": {
          "type": "string"
        },
        "matter_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        },
        "affiliates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Own-client affiliates from the staffing input; treated as this engagement's identity, never as another client."
        }
      }
    },
    "joiner": {
      "type": "object",
      "description": "First confirmed roster member with a joining onboarding_status; empty when none (wall-check then holds).",
      "properties": {
        "person": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "point_of_contact": {
          "type": "string"
        },
        "onboarding_status": {
          "type": "string"
        },
        "assignment_status": {
          "type": "string"
        },
        "staffing_review": {
          "type": "object",
          "description": "Present when Scenario 02 verdict is not eligible; verdict and rule only.",
          "properties": {
            "verdict": {
              "enum": [
                "needs_review",
                "ineligible",
                "conflicted",
                "blocked",
                "unrecognised"
              ]
            },
            "blocking_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "citation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    },
    "scope_summary": {
      "type": "object",
      "description": "SOW-derived; the SOW/engagement letter controls conflicts (confidentiality-and-ethical-wall-rules.md #1.2).",
      "properties": {
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_dates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "first_week_focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    },
    "team_roster": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roster_member"
      }
    },
    "proposed_staffing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_name": {
            "type": "string"
          },
          "role_title": {
            "type": "string"
          },
          "assignment_status": {
            "const": "proposed_not_assigned"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citation": {
            "type": "string",
            "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
          },
          "fit_score": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "staffing_exclusions": {
      "type": "array",
      "description": "Confirmed roster rows ineligible in Scenario 02; reasons stay in the staffing record.",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "blocking_rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "prior_knowledge_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge_item"
      }
    },
    "knowledge_digest": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ready",
            "empty",
            "hold",
            "denied_by_wall"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge_item"
          }
        },
        "excluded_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lesson_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              }
            }
          }
        },
        "denied_items": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    },
    "wall_decision": {
      "type": "object",
      "required": [
        "status",
        "citation"
      ],
      "properties": {
        "status": {
          "enum": [
            "clear",
            "hold",
            "denied"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Engine wording only; register free text is never copied."
        },
        "allowed_knowledge_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "denied_knowledge_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "denied_workspace_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "held_workspace_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name_withheld_workspace_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspaces shown by ID only because their name tripped the instruction tripwire or names another client or matter (confidentiality-and-ethical-wall-rules.md #3.2,#3.3)."
        },
        "may_not_access_discuss": {
          "type": "array",
          "description": "Screened briefing topics and restricted workspaces only; topics naming another client or matter are replaced with a placeholder and held (confidentiality-and-ethical-wall-rules.md #3.1,#3.2).",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "enum": [
                  "client_or_matter",
                  "workspace"
                ]
              },
              "restriction": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    },
    "access_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workspace_id",
          "status",
          "requested_permission"
        ],
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "workspace_name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "request",
              "denied_by_wall",
              "hold_pending_wall_review",
              "not_requested_role_not_allowed",
              "not_requested_exceeds_role",
              "not_requested_invalid_row"
            ]
          },
          "requested_permission": {
            "enum": [
              "none",
              "viewer",
              "member",
              "contributor"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Engine wording; a clamped request names the requested, default and ceiling permissions (role-access-matrix.md #2.3)."
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citation": {
            "type": "string",
            "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
          },
          "workspace_type": {
            "type": "string"
          }
        }
      }
    },
    "mobilization_pack": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "draft_internal_only",
            "on_hold_internal_only"
          ]
        },
        "hold_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "open_holds",
              "wall_status_hold",
              "workspaces_pending_wall_review"
            ]
          },
          "description": "Why the pack is on hold; empty only when status is draft_internal_only (workspace-inventory-rules.md #3.3)."
        },
        "label": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hold_id",
          "path",
          "reason",
          "citation"
        ],
        "properties": {
          "hold_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Source path of the held field."
          },
          "reason": {
            "type": "string",
            "description": "e.g. embedded_instruction:<family>[,<family>...] (pattern family names only; flagged text is never echoed), missing ethical-wall register, unknown wall status, briefing topic names another client, invalid workspace inventory row. Text naming another client or matter is withheld with reason 'text names another client or matter (name not repeated)'; permission clamps hold as HOLD-PERMISSION-CLAMPED."
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citation": {
            "type": "string",
            "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "engagement_terms": {
      "type": "object",
      "properties": {
        "confidentiality_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ethical_wall_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      }
    }
  },
  "$defs": {
    "roster_member": {
      "type": "object",
      "properties": {
        "person": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "point_of_contact": {
          "type": "string"
        },
        "onboarding_status": {
          "type": "string"
        },
        "assignment_status": {
          "const": "confirmed"
        },
        "staffing_review": {
          "type": "object",
          "description": "Present when Scenario 02 verdict is not eligible; verdict and rule only.",
          "properties": {
            "verdict": {
              "enum": [
                "needs_review",
                "ineligible",
                "conflicted",
                "blocked",
                "unrecognised"
              ]
            },
            "blocking_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "citation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "description": "Source row/section or reference rule (e.g. role-access-matrix.md #2.1)."
        }
      },
      "required": [
        "person",
        "role",
        "assignment_status"
      ]
    },
    "knowledge_item": {
      "type": "object",
      "properties": {
