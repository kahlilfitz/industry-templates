          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clearance_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidentiality_permission": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "pending_practice_review",
            "cleared_for_internal_reuse"
          ]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citations": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
