{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.time-expense-narrative-compliance.v1",
  "title": "Time & Expense Narrative Compliance contract v1",
  "description": "Chains activity-pull -> narrative-draft -> code-map -> guideline-check (Govern) -> exception-report. Every hop carries data, confidence, provenance and citations. v1.0.3 remains backward compatible: existing narratives stay unchanged while optional suggested_rewrites are separately labeled; compliance flags may include no_linked_evidence and recommended_task_code may be BH910; purpose may be null; optional organizer, attendees, deliverable, excluded_activity_ids and provenance.excluded_signals / signal_policy record signal-privacy exclusions (client-billing-guidelines.md #10.1).",
  "type": "object",
  "required": [
    "contract_version",
    "engagement",
    "period",
    "activity_signals",
    "time_entries"
  ],
  "properties": {
    "contract_version": {
      "const": "ps.time-expense-narrative-compliance.v1"
    },
    "engagement": {
      "type": "object",
      "required": [
        "engagement_id",
        "client_name",
        "matter_name"
      ],
      "properties": {
        "engagement_id": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "matter_name": {
          "type": "string"
        },
        "billing_guidelines_id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "signal_config": {
      "type": "object"
    },
    "activity_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "activity_id",
          "person",
          "date",
          "activity_class",
          "duration_hours",
          "subject",
          "purpose",
          "source",
          "confidence",
          "citations"
        ],
        "properties": {
          "activity_id": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "activity_class": {
            "type": "string"
          },
          "duration_hours": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client-facing purpose from a controlled source (engagement workplan); null when none is recorded - never invented."
          },
          "meeting_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "billable_signal": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "pattern": "^(engine|skill|connector):"
          },
          "confidence": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Meeting organizer from calendar metadata; drives Led vs Attended."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "time_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "person",
          "date",
          "duration_hours",
          "source",
          "confidence",
          "citations"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "duration_hours": {
            "type": "number"
          },
          "narrative": {
            "type": "string"
          },
          "activity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submitted_phase_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "submitted_task_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "draft": {
            "type": "object"
          },
          "code_mapping": {
            "type": "object"
          },
          "compliance": {
            "type": "object"
          },
          "source": {
            "type": "string",
            "pattern": "^(engine|skill|connector):"
          },
          "confidence": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded_activity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Links removed because the signal came from a disabled, unknown or unresolvable source (client-billing-guidelines.md #10.1)."
          }
        }
      }
    },
    "code_structure": {
      "type": "object"
    },
    "guidelines": {
      "type": "object"
    },
    "missing_time_report": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exception_list": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prebill_summary": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string"
        },
        "demo_scenario": {
          "type": "string"
        },
        "excluded_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "activity_id",
              "reason",
              "citations"
            ],
            "properties": {
              "activity_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "excluded_by": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "signal_policy": {
          "type": "object"
        },
        "skipped_sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
