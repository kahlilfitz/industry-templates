{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.time-expense-narrative-compliance.v1",
  "title": "Time & Expense Narrative Compliance contract v1",
  "description": "Chains activity-pull -> narrative-draft -> code-map -> guideline-check (Govern) -> exception-report. Every hop carries data, confidence, provenance and citations. v1.0.4 remains backward compatible: existing narratives stay unchanged while optional suggested_rewrites are separately labeled; compliance flags may include no_linked_evidence and recommended_task_code may be BH910; purpose may be null; optional organizer, attendees, deliverable, excluded_activity_ids and provenance.excluded_signals / signal_policy record signal-privacy exclusions (client-billing-guidelines.md #10.1). v1.0.4 adds optional engagement.engagement_manager, provenance.timekeeper_scope (requester, mode self|team, engagement-manager team_view confirmation, withheld rows; client-billing-guidelines.md #12.1) and provenance.period_check, draft.covered_activity_ids, and embedded_instruction markers on signals, entries and missing-time items; flagged text is withheld from drafts, rewrites and missing-time listings (#11.1, #11.2). Every engine validates every field it reads (signal_policy.validate_packet): a wrong JSON type, a missing required field or an unrecognised enum value is an input error with no output, never coerced.",
  "type": "object",
  "required": [
    "contract_version",
    "engagement",
    "period",
    "activity_signals",
    "time_entries"
  ],
  "properties": {
    "contract_version": {
      "const": "ps.time-expense-narrative-compliance.v1"
    },
    "engagement": {
      "type": "object",
      "required": [
        "engagement_id",
        "client_name",
        "matter_name"
      ],
      "properties": {
        "engagement_id": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "matter_name": {
          "type": "string"
        },
        "billing_guidelines_id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engagement_manager": {
          "type": [
            "string",
            "null"
          ],
          "description": "Engagement manager recorded in the engagement letter; the only requester who can be granted the team view (client-billing-guidelines.md #12.1)."
        }
      }
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "signal_config": {
      "type": "object"
    },
    "activity_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "activity_id",
          "person",
          "date",
          "activity_class",
          "duration_hours",
          "subject",
          "purpose",
          "source",
          "confidence",
          "citations"
        ],
        "properties": {
          "activity_id": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "activity_class": {
            "type": "string"
          },
          "duration_hours": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client-facing purpose from a controlled source (engagement workplan); null when none is recorded - never invented."
          },
          "meeting_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "billable_signal": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "pattern": "^(engine|skill|connector):"
          },
          "confidence": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Meeting organizer from calendar metadata; drives Led vs Attended."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": [
              "string",
              "null"
            ]
          },
          "embedded_instruction": {
            "type": "boolean",
            "description": "True when free text in the signal trips the embedded-instruction tripwire; the text is never drafted from or displayed (client-billing-guidelines.md #11.1, #11.2)."
          }
        }
      }
    },
    "time_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "person",
          "date",
          "duration_hours",
          "source",
          "confidence",
          "citations"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "duration_hours": {
            "type": "number"
          },
          "narrative": {
            "type": "string"
          },
          "activity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submitted_phase_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "submitted_task_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "draft": {
            "type": "object",
            "description": "narrative_draft output: narrative, status (engine_generated_from_activity, needs_review, needs_review_insufficient_detail, needs_review_embedded_instruction, needs_activity_evidence, existing_timesheet_narrative), review_reasons, linked_activity_ids, covered_activity_ids (every linked activity the draft or rewrites describe), excluded_activity_ids, optional suggested_rewrites[] (status withheld_embedded_instruction when guideline_check withholds one), confidence, source, citations."
          },
          "code_mapping": {
            "type": "object"
          },
          "compliance": {
            "type": "object"
          },
          "source": {
            "type": "string",
            "pattern": "^(engine|skill|connector):"
          },
          "confidence": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded_activity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Links removed because the signal came from a disabled, unknown or unresolvable source (client-billing-guidelines.md #10.1)."
          },
          "embedded_instruction": {
            "type": "boolean",
            "description": "True when the existing narrative or notes trip the embedded-instruction tripwire (client-billing-guidelines.md #11.1)."
          }
        }
      }
    },
    "code_structure": {
      "type": "object"
    },
    "guidelines": {
      "type": "object"
    },
    "missing_time_report": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Unrecorded billable activity; a subject that trips the tripwire is replaced by the withheld marker and the item carries embedded_instruction: true (client-billing-guidelines.md #8.1, #11.2)."
      }
    },
    "exception_list": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prebill_summary": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string"
        },
        "demo_scenario": {
          "type": "string"
        },
        "excluded_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "activity_id",
              "reason",
              "citations"
            ],
            "properties": {
              "activity_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "excluded_by": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "signal_policy": {
          "type": "object"
        },
        "skipped_sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timekeeper_scope": {
          "type": "object",
          "description": "Recorded by activity_pull and enforced by every engine: only the requester's rows unless a confirmed engagement-manager team view is recorded (client-billing-guidelines.md #12.1).",
          "properties": {
            "mode": {
              "enum": [
                "self",
                "team"
              ]
            },
            "requester": {
              "type": "string"
            },
            "people": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "team_view": {
              "type": [
                "object",
                "null"
              ],
              "description": "Set only by activity_pull. confirmed must be a JSON boolean (a string such as \"true\" or \"yes\" is an input error, never a confirmation); role and confirmation are closed values.",
              "required": [
                "confirmed",
                "role",
                "confirmation"
              ],
              "properties": {
                "confirmed": {
                  "type": "boolean"
                },
                "role": {
                  "enum": [
                    "engagement_manager"
                  ]
                },
                "confirmation": {
                  "type": "string",
                  "pattern": "^engagement-manager:[A-Za-z0-9._-]+$"
                }
              }
            },
            "withheld": {
              "type": [
                "object",
                "null"
              ]
            },
            "withheld_by_engines": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "period_check": {
          "type": "object",
          "description": "Whether the requested period holds any data (status data_found, no_data_in_period or no_period_requested) with a warning naming the dates that do.",
          "properties": {
            "status": {
              "enum": [
                "data_found",
                "no_data_in_period",
                "no_period_requested"
              ]
            },
            "warning": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
