{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.conflicts-independence-precheck.v1",
  "title": "Conflicts & Independence Pre-Check contract v1",
  "description": "Chains party-intake -> entity-resolve -> register-search -> conflict-classify -> clearance-memo. Carries data + confidence + provenance + citations on every hop so holds and escalations are mechanical.",
  "type": "object",
  "required": ["contract_version", "pursuit_id", "prospective_client", "matter", "parties"],
  "properties": {
    "contract_version": { "const": "ps.conflicts-independence-precheck.v1" },
    "pursuit_id": { "type": "string" },
    "analysis_as_of": { "type": "string" },
    "prospective_client": {
      "type": "object",
      "required": ["party_id", "given_name", "role", "source", "citation", "confidence"],
      "properties": {
        "party_id": { "type": "string" },
        "given_name": { "type": "string" },
        "role": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "matter": {
      "type": "object",
      "required": ["matter_name", "matter_type", "services", "description", "source", "citation", "confidence"],
      "properties": {
        "matter_name": { "type": "string" },
        "matter_type": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "jurisdictions": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["party_id", "given_name", "role", "source", "citation", "confidence"],
        "properties": {
          "party_id": { "type": "string" },
          "given_name": { "type": "string" },
          "role": { "type": "string" },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "resolved_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["party_id", "given_name", "match_status", "confidence", "source", "citation", "rule"],
        "properties": {
          "party_id": { "type": "string" },
          "given_name": { "type": "string" },
          "role": { "type": "string" },
          "match_status": { "enum": ["controlled_match", "fuzzy_match", "human_review", "no_match"] },
          "resolved_entity_id": { "type": ["string", "null"] },
          "resolved_legal_name": { "type": ["string", "null"] },
          "candidate_entity_id": { "type": ["string", "null"] },
          "candidate_legal_name": { "type": ["string", "null"] },
          "family_id": { "type": ["string", "null"] },
          "ultimate_parent_id": { "type": ["string", "null"] },
          "ultimate_parent_name": { "type": ["string", "null"] },
          "entity_variants_tried": { "type": "array", "items": { "type": "string" } },
          "corporate_family": { "type": "array", "items": { "type": "object" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "search_scope": {
      "type": "object",
      "properties": {
        "registers_searched": { "type": "array", "items": { "type": "string" }, "description": "Registers the engine actually read. Derived from engine coverage, never copied from the input claim." },
        "registers_not_searched": { "type": "array", "items": { "type": "string" }, "description": "Registers supplied but not covered by the engine. Non-empty means the search is incomplete and the result must not be read as clean." },
        "date_range": { "type": "object" },
        "entity_variants_by_party": { "type": "object" },
        "corporate_family_entity_ids": { "type": "array", "items": { "type": "string" } },
        "unresolved_parties": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" }
      }
    },
    "conflict_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hit_id", "register", "conflict_type", "matched_entity", "match_score", "relationship", "rule", "source", "citation", "confidence"],
        "properties": {
          "hit_id": { "type": "string" },
          "register": { "type": "string" },
          "record_id": { "type": "string" },
          "conflict_type": { "type": "string" },
          "matched_entity": { "type": "string" },
          "matched_entity_id": { "type": ["string", "null"] },
          "match_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "relationship": { "type": "string" },
          "governing_rule": { "type": "string" },
          "waiver_posture": { "type": "string" },
          "ethical_wall_recommendation": { "type": "string" },
          "required_action": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "prior_clearance_context": {
      "type": "array",
      "description": "Prior clearance decisions for in-scope entities. Context for the human reviewer only; must never downgrade, suppress or resolve a hit.",
      "items": {
        "type": "object",
        "required": ["decision_id", "entity_id", "effect", "source", "citation"],
        "properties": {
          "decision_id": { "type": "string" },
          "entity_id": { "type": "string" },
          "summary": { "type": "string" },
          "effect": { "const": "non_controlling_context_only" },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "precheck_position": {
      "type": "object",
      "properties": {
        "position": { "enum": ["no_hits_found_subject_to_review", "escalate_to_qrm", "hold_for_human_review"] },
        "human_clearance_required": { "type": "boolean" },
        "draft_output": { "enum": ["proposed_clearance_memo", "escalation_packet"] },
        "summary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" }
      }
    },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string" },
        "demo_scenario": { "type": "string" }
      }
    }
  }
}
