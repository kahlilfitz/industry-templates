{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.client-status-qbr.v1",
  "title": "Client Status & QBR contract v1",
  "description": "Versioned contract chaining plan-retrieve -> burn-pull -> variance-calc -> risk-summarize -> status-draft. Carries data + confidence + provenance + citations on every hop so escalation is mechanical. Hop ownership: plan-retrieve writes engagement, reporting_period, sources, plan and prior_status; burn-pull writes budget; variance-calc writes variance_summary; risk-summarize writes aged_items; status-draft consumes the payload and writes no contract fields. Only the hop-1 fields are globally required so that each intermediate payload validates.",
  "type": "object",
  "required": [
    "contract_version",
    "engagement",
    "reporting_period",
    "plan"
  ],
  "properties": {
    "contract_version": {
      "const": "ps.client-status-qbr.v1"
    },
    "engagement": {
      "type": "object",
      "required": [
        "engagement_id",
        "name",
        "client_name",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "engagement_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "manager": {
          "type": "string"
        },
        "partner": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        },
        "project_code": {
          "type": "string",
          "description": "Client-side or finance-system project code, used to tie the finance export back to the engagement. Optional."
        }
      }
    },
    "reporting_period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "previous_start": {
          "type": "string",
          "format": "date"
        },
        "previous_end": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source_record"
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "milestones",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/milestone"
          }
        },
        "scope_changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scope_change"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "prior_status": {
      "type": "object",
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/prior_milestone"
          }
        },
        "budget": {
          "$ref": "#/definitions/prior_budget"
        },
        "reported_rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "currency",
        "baseline_budget",
        "planned_burn_to_date",
        "actual_billed_to_date",
        "unbilled_wip",
        "forecast_to_complete",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "baseline_budget": {
          "type": "number",
          "description": "Approved baseline budget for the whole engagement, in the engagement currency."
        },
        "planned_burn_to_date": {
          "type": "number"
        },
        "actual_billed_to_date": {
          "type": "number"
        },
        "unbilled_wip": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unbilled work in progress / accrual in the engagement currency. Use null only when the finance export genuinely has no WIP line, and raise an escalation; never omit the field and never substitute 0 for unknown."
        },
        "forecast_to_complete": {
          "type": "number",
          "description": "Estimate at completion (EAC): total forecast cost for the whole engagement including burn already incurred, in the engagement currency. This is NOT the remaining cost to complete. variance-calc compares it directly to baseline_budget under status-reporting-rules.md #3.2."
        },
        "previous_forecast_to_complete": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        },
        "field_citations": {
          "type": "object",
          "description": "Per-field provenance for the budget block. Each key is a budget field name and each value is the exact source row or cell it came from, e.g. {\"actual_billed_to_date\":\"fin-export.csv row 12\"}. Lets a reviewer audit one number without re-opening every source.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "variance_summary": {
      "type": "object",
      "properties": {
        "schedule": {
          "$ref": "#/definitions/domain_status"
        },
        "budget": {
          "$ref": "#/definitions/domain_status"
        },
        "scope": {
          "$ref": "#/definitions/domain_status"
        },
        "overall_rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "aged_items": {
      "type": "object",
      "properties": {
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/aged_item"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/aged_item"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/aged_item"
          }
        },
        "pending_client_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/aged_item"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "escalations": {
      "type": "array",
      "description": "Items a human must resolve before the pack is sent. Either a plain sentence or a structured object; both forms are valid so existing consumers keep working.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "message",
              "rule"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "rule": {
                "type": "string",
                "description": "The status-reporting-rules.md rule number that triggered this escalation, e.g. '#3.3'."
              },
              "item_id": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "pattern": "^(engine|skill|connector):"
              }
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "demo_scenario": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "source_record": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "name",
        "current_forecast_date",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "original_baseline_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "The milestone's first committed baseline. Absent or null when no supplied source gives it - never copy current_baseline_date into it. variance_calc then reports original_variance_days as null, forces schedule to at least amber and escalates under status-reporting-rules.md #2.3, because masked slippage cannot be tested."
        },
        "current_baseline_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "current_forecast_date": {
          "type": "string",
          "format": "date"
        },
        "reported_rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "rebaselined_last_period": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "prior_milestone": {
      "type": "object",
      "required": [
        "id",
        "forecast_date",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "forecast_date": {
          "type": "string",
          "format": "date"
        },
        "reported_rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        },
        "baseline_date": {
          "type": "string",
          "format": "date",
          "description": "The baseline date as reported in the prior pack. Used to detect a baseline that moved between periods."
        }
      }
    },
    "scope_change": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "client_facing_impact",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "client_facing_impact": {
          "type": "boolean"
        },
        "impact_days": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "prior_budget": {
      "type": "object",
      "properties": {
        "forecast_to_complete": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "owner_type",
        "source",
        "confidence",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "opened_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the item was opened. Absent or null means the register did not record one; item_age escalates the gap (status-reporting-rules.md #4.x). Never guess a date to satisfy this field."
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Due date where the register records one. Absent or null means unknown, not 'not overdue'."
        },
        "owner_type": {
          "enum": [
            "client",
            "internal",
            "joint"
          ]
        },
        "blocked_by_decision_id": {
          "type": "string"
        },
        "blocker_type": {
          "enum": [
            "client_decision",
            "internal_dependency",
            "none"
          ]
        },
        "risk_rating": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "domain_status": {
      "type": "object",
      "properties": {
        "rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "aged_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "risk",
            "decision",
            "action",
            "item"
          ],
          "description": "Which RAID register the item came from. Emitted by item_age."
        },
        "title": {
          "type": "string"
        },
        "age_days": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Null when opened_date is unknown. Null means unmeasurable and is always accompanied by an escalation; it must never be rendered as 0."
        },
        "days_past_due": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Null when due_date is unknown. Null means unmeasurable and is always accompanied by an escalation; it must never be rendered as 0 or as 'on track'."
        },
        "due_date_known": {
          "type": "boolean",
          "description": "False when the item carries no due date, so days_past_due is null by definition."
        },
        "bucket": {
          "type": "string"
        },
        "owner_type": {
          "enum": [
            "client",
            "internal",
            "joint"
          ]
        },
        "client_action": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^(engine|skill|connector):"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string"
        }
      }
    }
  }
}
