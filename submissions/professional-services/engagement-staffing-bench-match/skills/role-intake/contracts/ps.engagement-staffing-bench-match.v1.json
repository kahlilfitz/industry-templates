{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.engagement-staffing-bench-match.v1",
  "title": "Engagement Staffing & Bench Match contract v1",
  "description": "Chains role-intake -> bench-query -> fit-score -> constraint-check -> slate-draft. Carries data, confidence, provenance and citations so fit scores, ranks, utilisation figures and eligibility refusals are auditable.",
  "type": "object",
  "required": ["contract_version", "engagement", "roles"],
  "properties": {
    "contract_version": { "const": "ps.engagement-staffing-bench-match.v1" },
    "engagement": {
      "type": "object",
      "required": ["engagement_id", "client_name", "affiliates", "source", "confidence", "citation"],
      "properties": {
        "engagement_id": { "type": "string" },
        "client_name": { "type": "string" },
        "affiliates": {
          "type": "array",
          "description": "Known parent companies, subsidiaries and affiliates whose conflict records apply to this engagement.",
          "items": { "type": "string" }
        },
        "practice": { "type": "string" },
        "stage": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation": { "type": "string" }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role_id", "title", "start_date", "allocation_pct", "required_skills", "source", "confidence", "citation"],
        "properties": {
          "role_id": { "type": "string" },
          "title": { "type": "string" },
          "seniority": { "type": "string" },
          "start_date": { "type": "string" },
          "duration_weeks": { "type": "integer", "minimum": 1 },
          "allocation_pct": { "type": "number", "minimum": 1, "maximum": 100 },
          "location": { "type": "string" },
          "remote_ok": { "type": "boolean" },
          "required_languages": { "type": "array", "items": { "type": "string" } },
          "industry_context": { "type": "string" },
          "required_skills": { "type": "array", "items": { "type": "string" } },
          "preferred_skills": { "type": "array", "items": { "type": "string" } },
          "required_certifications": { "type": "array", "items": { "type": "string" } },
          "rate_band": {
            "type": "object",
            "properties": {
              "currency": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "citation": { "type": "string" }
        }
      }
    },
    "bench_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "name", "skills", "source", "confidence", "citation"],
        "properties": {
          "candidate_id": { "type": "string" },
          "name": { "type": "string" },
          "seniority": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "certifications": { "type": "array", "items": { "type": "string" } },
          "industry_experience": { "type": "array", "items": { "type": "string" } },
          "location": { "type": "string" },
          "languages": { "type": "array", "items": { "type": "string" } },
          "rate": { "type": "number" },
          "current_allocation_pct": { "type": "number" },
          "target_utilization_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "The firm's planning target for the candidate's billable utilisation. It is context only and does not change effective available capacity."
          },
          "approved_leave": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "allocation_pct"],
              "properties": {
                "start": { "type": "string" },
                "end": {
                  "type": "string",
                  "description": "Optional. Missing end dates are treated as open-ended and force review."
                },
                "allocation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "citation": { "type": "string" }
              }
            }
          },
          "soft_bookings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "allocation_pct"],
              "properties": {
                "start": { "type": "string" },
                "end": {
                  "type": "string",
                  "description": "Optional. Missing end dates are treated as open-ended and force review."
                },
                "allocation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "citation": { "type": "string" }
              }
            }
          },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "citation": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Normalized conflicts-register records owned by bench-query and evaluated only by constraint-check.",
      "items": {
        "type": "object",
        "required": ["candidate_id", "type", "source", "confidence", "citation"],
        "properties": {
          "candidate_id": { "type": "string" },
          "type": { "type": "string" },
          "client_name": { "type": "string" },
          "status": { "type": "string" },
          "material": { "type": ["boolean", "null"] },
          "role_type": { "type": "string" },
          "process": { "type": "string" },
          "end_date": { "type": "string" },
          "resolved_date": { "type": "string" },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "citation": { "type": "string" }
        }
      }
    },
    "scored_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_id": { "type": "string" },
          "candidate_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["candidate_id", "fit_score", "source", "confidence", "citation"],
              "properties": {
                "candidate_id": { "type": "string" },
                "candidate_name": { "type": "string" },
                "fit_score": { "type": "number" },
                "component_scores": { "type": "object" },
                "component_citations": { "type": "object" },
                "availability_context": { "type": "object" },
                "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "citation": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "ranked_roles": { "type": "array" },
    "governed_roles": {
      "type": "array",
      "description": "Governed candidate slates. Each candidate includes constraints_considered[] so slate-draft can independently refuse unexplained conflict records.",
      "items": {
        "type": "object",
        "properties": {
          "role_id": { "type": "string" },
          "role_title": { "type": "string" },
          "candidate_slate": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": { "type": "string" },
                "constraints_considered": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "applies_to_engagement", "disposition", "reason", "citation"],
                    "properties": {
                      "type": { "type": "string" },
                      "client_name": { "type": "string" },
                      "status": { "type": "string" },
                      "material": { "type": ["boolean", "null"] },
                      "applies_to_engagement": { "type": "boolean" },
                      "disposition": { "type": "string" },
                      "reason": { "type": "string" },
                      "source": { "type": "string" },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                      "citation": { "type": "string" }
                    }
                  }
                },
                "eligibility": {
                  "type": "object",
                  "properties": {
                    "verdict": { "type": "string" },
                    "recommendation_status": { "type": "string" },
                    "blocking_rule": { "type": ["string", "null"] },
                    "reasons": { "type": "array", "items": { "type": "string" } },
                    "source": { "type": "string" },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "citation": { "type": "string" }
                  }
                },
                "secondary_validation": { "type": "object" }
              }
            }
          },
          "recommended_candidates": { "type": "array" }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" }
  }
}
