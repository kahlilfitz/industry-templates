{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.engagement-financial-health-brief.v1",
  "title": "Engagement Financial Health Brief contract v1",
  "description": "Versioned contract chaining financials-pull -> health-calc -> driver-attribute -> benchmark-compare -> brief-draft. Carries data, confidence, provenance and citations across every hop so financial health indicators and comparison boundaries are mechanical.",
  "type": "object",
  "required": ["contract_version", "engagement"],
  "properties": {
    "contract_version": { "const": "ps.engagement-financial-health-brief.v1" },
    "engagement": {
      "type": "object",
      "required": ["engagement_id", "client_name", "engagement_name", "metric_definition_set_id", "source", "citation", "confidence"],
      "properties": {
        "engagement_id": { "type": "string" },
        "client_name": { "type": "string" },
        "engagement_name": { "type": "string" },
        "practice": { "type": "string" },
        "review_period": { "type": "string" },
        "metric_definition_set_id": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_revision": { "type": "string" },
        "planned_revenue_to_date": { "type": "number" },
        "planned_delivery_cost_to_date": { "type": "number" },
        "planned_total_delivery_cost": { "type": "number" },
        "planned_remaining_delivery_cost": { "type": "number" },
        "planned_margin_pct": { "type": "number" },
        "system_etc_cost": { "type": "number" },
        "senior_review_plan_to_date": { "type": "object", "additionalProperties": { "type": "number" } },
        "milestones": { "type": "array", "items": { "type": "object" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "status", "definition_section", "confidence", "source", "citation"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "status": { "enum": ["green", "amber", "red", "not_evaluated"] },
          "plan_value": { "type": ["number", "null"] },
          "threshold": { "type": "object" },
          "definition_section": { "type": "string" },
          "metric_definition_set_id": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" }
        }
      }
    },
    "wip_ageing": {
      "type": "object",
      "properties": {
        "buckets": { "type": "array", "items": { "type": "object" } },
        "total_wip": { "type": "number" },
        "over_90_amount": { "type": "number" },
        "over_90_pct": { "type": "number" },
        "collectability_reserve": { "type": "number" },
        "definition_section": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "forecast": {
      "type": "object",
      "properties": {
        "etc_cost": { "type": "number" },
        "eac_cost": { "type": "number" },
        "eac_variance_amount": { "type": "number" },
        "eac_over_plan_pct": { "type": "number" },
        "system_etc_cost": { "type": "number" },
        "milestone_slip_remediation_cost": { "type": "number" },
        "deferred_senior_review_cost": { "type": "number" },
        "definition_section": { "type": "string" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "composite_score": { "type": "number" },
        "overall_status": { "enum": ["green", "amber", "red"] },
        "early_warning_flags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "benchmark_comparison": {
      "type": "object",
      "properties": {
        "status": { "enum": ["compared", "refused"] },
        "reason": { "type": "string" },
        "definition_set_match": { "type": "boolean" },
        "benchmark_definition_set_id": { "type": "string" },
        "comparisons": { "type": "array", "items": { "type": "object" } },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "driver_attribution": {
      "type": "object",
      "properties": {
        "largest_variance": { "type": "string" },
        "total_variance": { "type": "number" },
        "components": { "type": "array", "items": { "type": "object" } },
        "reconciles": { "type": "boolean" },
        "reconciliation_delta": { "type": "number" },
        "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
        "citation": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "engines": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string" },
        "demo_scenario": { "type": "string" }
      }
    }
  }
}
