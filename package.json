{
  "name": "industry-templates",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Build ready-to-install industry template bundles for Microsoft 365 Copilot Cowork, Copilot Studio, and Scout.",
  "scripts": {
    "build": "tsx scripts/import-submissions.ts",
    "import:submissions": "npm run build",
    "check:submissions": "tsx scripts/import-submissions.ts --check",
    "check:shared": "tsx scripts/check-shared-modules.ts",
    "evaluation:prepare": "tsx scripts/prepare-evaluation.ts",
    "evaluation:archive": "tsx scripts/archive-evaluation.ts",
    "evaluation:watch": "tsx scripts/watch-evaluation.ts",
    "sharepoint:link": "tsx scripts/sharepoint.ts link",
    "sharepoint:doctor": "tsx scripts/sharepoint.ts doctor",
    "sharepoint:unlink": "tsx scripts/sharepoint.ts unlink",
    "test:evaluation": "tsx --test scripts/evaluation-workflow.test.ts scripts/sharepoint-sync.test.ts scripts/shared-modules.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "adm-zip": "^0.5.16",
    "tsx": "^4.22.4"
  }
}
